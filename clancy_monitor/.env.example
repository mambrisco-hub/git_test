# ─── Lindsay Clancy Case Monitor — Environment Variables ───────────────────
# Copy this file to .env and fill in your credentials.
# Never commit .env to source control.

# ── Claude / Anthropic API (REQUIRED for brief generation) ──────────────────
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── X / Twitter API v2 (optional — enables tweet scraping) ──────────────────
# Free/Basic tier at: https://developer.twitter.com/en/portal/dashboard
# Provides ~500k tweet reads/month via the recent-search endpoint.
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here

# ── Meta Graph API (optional — enables Facebook + Instagram scraping) ────────
# Create an app at: https://developers.facebook.com/apps/
# Long-lived page access token required for Graph API access.
META_ACCESS_TOKEN=your_meta_access_token_here

# Comma-separated Facebook page IDs to monitor (page slugs or numeric IDs)
# These are page usernames or IDs, e.g., "bbcnews" or "123456789"
META_PAGE_IDS=lawandcrime,crimeonline,bostonglobe,bostonherald,wcvb5,wbznews,people

# Comma-separated Instagram Business account numeric IDs
# Obtain via Graph API: GET /me/accounts → instagram_business_account.id
META_IG_USER_IDS=

# ── TikTok Research API (optional — enables TikTok scraping) ────────────────
# Apply at: https://developers.tiktok.com/products/research-api/
# Academic/researcher access required.
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# ── Email Delivery (optional — sends brief to your inbox daily) ──────────────
# Uses Gmail SMTP. Create an App Password at myaccount.google.com/apppasswords
# (do NOT use your main Gmail password here)
SMTP_FROM=yourname@gmail.com
SMTP_TO=yourname@gmail.com,spousename@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# ── Railway (set automatically by Railway, do not change) ───────────────────
# PORT is injected by Railway for the web service
# OUTPUT_DIR — set to /data/output if you attach a Railway Volume at /data
OUTPUT_DIR=./output
